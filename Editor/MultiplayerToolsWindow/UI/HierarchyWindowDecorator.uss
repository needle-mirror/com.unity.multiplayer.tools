/* Static layout for the NetworkObject info injected into hierarchy rows. Dynamic state (icon, owner id text,
   visibility) is set from code in HierarchyWindowDecorator. */

.multiplayer-tools-network-info {
    flex-direction: row;
    align-items: center;
}

.multiplayer-tools-network-info__owner-id {
    -unity-text-align: middle-right;
    margin-right: 2px;
}

.multiplayer-tools-network-info__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}
